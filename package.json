{
  "name": "@local/dsh-context-monitor",
  "version": "0.1.6",
  "private": true,
  "description": "Read-only context, compaction structure and provider cache telemetry for DSH, with optional billion-context-dsh ACP integration.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NekogamiJam/dsh-context-monitor.git"
  },
  "homepage": "https://github.com/NekogamiJam/dsh-context-monitor#readme",
  "bugs": {
    "url": "https://github.com/NekogamiJam/dsh-context-monitor/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "usage",
    "compaction",
    "monitor"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "model.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check model.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "semver": "7.8.5"
  }
}

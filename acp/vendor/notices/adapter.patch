+import type { AcpConfig } from './index.ts';
+import type { SettingsCommandSurface } from './settings.ts';
+
+export function validateRecognizedAcpLedgerEntry(
+  event: unknown,
+  index: number,
+  events: readonly unknown[],
+  knownCompactionIds: Set<string>,
+  knownKernelBlockIds: Set<string>,
+): void {
+  const isRecord = (value: unknown): value is Record<string, unknown> => value !== null && typeof value === 'object' && !Array.isArray(value);
+  const item = isRecord(event) ? event : {};
+  if (item.type !== 'compaction/summary') return;
+  const data = isRecord(item.data) ? item.data : {};
+  const compactionId = typeof data.compactionId === 'string' && data.compactionId.length > 0
+    ? data.compactionId : `event-${index}`;
+  let ledger: Record<string, unknown> | undefined;
+  if (Array.isArray(data.rawOutput)) {
+    for (const block of data.rawOutput) {
+      if (!isRecord(block) || block.type !== 'text' || typeof block.text !== 'string') continue;
+      let parsed: unknown;
+      try { parsed = JSON.parse(block.text); } catch { continue; }
+      if (isRecord(parsed) && parsed.$dshAcpBlockLedger === 1) { ledger = parsed; break; }
+    }
+  }
+  if (ledger === undefined) {
+    if (typeof data.compactionId === 'string' && data.compactionId.length > 0) knownCompactionIds.add(data.compactionId)
+    return; // Generic/stock or unsupported-version records keep their existing behavior.
+  }
+  const fail = (reason: string): never => {
+    throw new Error(`ACP ledger v1 recovery rejected compaction ${compactionId}: ${reason}; repair or restore the session ledger before sending a provider request`);
+  };
+  if (typeof data.compactionId !== 'string' || data.compactionId.length === 0) return fail('compactionId is missing');
+  if (knownCompactionIds.has(data.compactionId)) return fail(`duplicate compactionId ${data.compactionId}`);
+  const seqs = data.shadowedSeqs;
+  if (!Array.isArray(seqs) || seqs.length === 0 || !seqs.every((seq) => Number.isInteger(seq) && seq >= 0 && seq < index && events[seq] !== undefined)) {
+    fail('shadowedSeqs is missing an original event or contains an invalid seq');
+  }
+  const range = isRecord(data.shadowedRange) ? data.shadowedRange : undefined;
+  if (range === undefined || !Number.isInteger(range.start) || !Number.isInteger(range.end) || (range.start as number) > (range.end as number)) {
+    fail('shadowedRange provenance is missing or invalid');
+  }
+  if (typeof ledger.kernelBlockId !== 'string' || !/^b\d+$/.test(ledger.kernelBlockId)) return fail('kernelBlockId provenance is missing or invalid');
+  const kernelBlockId = ledger.kernelBlockId as string;
+  if (knownKernelBlockIds.has(kernelBlockId)) return fail(`duplicate kernelBlockId ${kernelBlockId}`);
+  const tierValue = ledger.tier ?? (data.tier === 2 || data.tier === 3 ? data.tier : 1);
+  if (tierValue !== 1 && tierValue !== 2 && tierValue !== 3) return fail('tier is invalid');
+  const tier = tierValue as 1 | 2 | 3;
+  const stringArray = (value: unknown, allowEmpty = false): value is string[] => Array.isArray(value) && (allowEmpty || value.length > 0) && value.every((id) => typeof id === 'string' && id.length > 0);
+  const directIdsValid = tier === 1
+    ? stringArray(ledger.directMessageIds)
+    : ledger.directMessageIds === undefined || stringArray(ledger.directMessageIds, true);
+  if (!directIdsValid || !stringArray(ledger.effectiveMessageIds)) return fail('direct/effective message provenance is missing or invalid');
+  if (tier > 1) {
+    if (!stringArray(ledger.parentBlockIds)) return fail(`tier ${tier} parentBlockIds are missing or invalid`);
+    const parents = ledger.parentBlockIds as string[];
+    for (const parent of parents) {
+      if (!knownCompactionIds.has(parent)) return fail(`tier ${tier} parent ${parent} is not present earlier in the ledger`);
+    }
+  } else if (ledger.parentBlockIds !== undefined && (!Array.isArray(ledger.parentBlockIds) || !ledger.parentBlockIds.every((id) => typeof id === 'string'))) {
+    return fail('parentBlockIds are invalid');
+  }
+  knownCompactionIds.add(data.compactionId as string)
+  knownKernelBlockIds.add(kernelBlockId);
+}
+
+export function readInitialRuntimeConfig(runtime: AcpRuntime): Partial<AcpConfig> {
+  const snapshot = runtime.readConfig();
+  if (snapshot === null || typeof snapshot !== 'object' || Array.isArray(snapshot)) {
+    throw new TypeError('AcpCompactionEngine runtime.readConfig() must return a configuration object');
+  }
+  const { runtime: _nestedRuntime, ...effective } = snapshot;
+  return effective;
+}
+
+export function surfaceSeqBounds(nodes: readonly number[]): { start: number; end: number } | null {
+  if (nodes.length === 0) return null;
+  let start = nodes[0]!;
+  let end = nodes[0]!;
+  for (let index = 1; index < nodes.length; index += 1) {
+    const seq = nodes[index]!;
+    if (seq < start) start = seq;
+    if (seq > end) end = seq;
+  }
+  return { start, end };
+}
+
+export const OPERATION_KINDS = ['nudge', 'overflow', 'compress', 'read', 'settings', 'prompt', 'cleanup'] as const;
+export type OperationKind = (typeof OPERATION_KINDS)[number];
+
+export interface AcpRuntime {
+  /** Return the coordinator's latest effective configuration snapshot. */
+  readConfig: () => Partial<AcpConfig>;
+  /** Acquire an operation lease, invoke fn, and release the lease in finally. */
+  runOperation: <T>(kind: OperationKind, fn: () => T | Promise<T>) => Promise<T | null> | T | null;
+  /** Optional adapter for the shared settings API; legacy config commands delegate here. */
+  settingsCommand?: SettingsCommandSurface;
+}
+
+export function isAcpRuntime(value: unknown): value is AcpRuntime {
+  if (value === null || typeof value !== 'object') return false;
+  const runtime = value as Partial<AcpRuntime>;
+  return typeof runtime.readConfig === 'function'
+    && typeof runtime.runOperation === 'function'
+    && (runtime.settingsCommand === undefined || typeof runtime.settingsCommand === 'object');
+}
+
+export function assertAcpRuntime(value: unknown): asserts value is AcpRuntime {
+  if (!isAcpRuntime(value)) {
+    throw new TypeError('AcpCompactionEngine runtime must provide readConfig() and runOperation(kind, fn)');
+  }
+}
+
+/** Manual/read actions must never silently fall back when their generation is unavailable. */
+export async function runRequiredOperation<T>(runtime: AcpRuntime | undefined, kind: OperationKind, fn: () => T | Promise<T>): Promise<T> {
+  const result = runtime === undefined ? await fn() : await runtime.runOperation(kind, fn);
+  if (result === null) throw new Error(`ACP ${kind} operation is unavailable (generation is not accepting work)`);
+  return result;
+}
